{
  "manifest_version": 3,
  "name": "PROA – Agendamento Marinha",
  "version": "0.2.1",
  "key": "",
  "description": "Preenche o agendamento para representante legal no SISAP com os dados do PROA e devolve o resultado.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "notifications"],
  "icons": {
    "48": "icons/icone48.png",
    "128": "icons/icone128.png"
  },
  "host_permissions": [
    "https://atendimento-dpc.marinha.mil.br/*",
    "https://sistemas.dpc.mar.mil.br/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PROA – Agendamento Marinha (configurações)"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://atendimento-dpc.marinha.mil.br/sisap/agendamento/*",
        "https://sistemas.dpc.mar.mil.br/sisap/agendamento/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://atendimento-dpc.marinha.mil.br/sisap/agendamento/*",
        "https://sistemas.dpc.mar.mil.br/sisap/agendamento/*"
      ],
      "js": ["lib.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
